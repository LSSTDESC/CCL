{
  "files.autoSave": "off",
  "notebook.formatOnCellExecution": false,
  "notebook.formatOnSave.enabled": false,
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.ruff": "never",
    "source.organizeImports.ruff": "never"
  },
  "esbonio.server.pythonCommand": [
    "/cosma/local/Python/3.12.4/bin/python3"
  ],
  "esbonio.sphinx.pythonCommand": [
    "/cosma/local/Python/3.12.4/bin/python3"
  ],
  "esbonio.sphinx.buildCommand": [
    "sphinx-build",
    "-M",
    "html",
    "readthedocs",
    "readthedocs/_build"
  ],
  "esbonio.preview.synchronizeScroll": "bothWays"
}
